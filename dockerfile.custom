FROM naidarksite.azurecr.io/vllm:idle-demote-v2

# Remove old python/C++ bindings
RUN find /usr/local/lib/python3.12/dist-packages/vllm/ -name "*.py" -type f -delete

# Copy modified Python code
COPY ./vllm /usr/local/lib/python3.12/dist-packages/vllm/

# Rebuild custom CUDA extensions so _C.so matches the Python interfaces
RUN python3 setup.py develop